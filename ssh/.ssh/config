Host rasppy
    HostName 192.168.0.139
    User rujul
    IdentityFile ~/.ssh/id_rasppy
    IdentitiesOnly yes
    AddKeysToAgent yes

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_personal
  AddKeysToAgent yes

Host mac
    HostName 192.168.1.5
    User rujul

Host ssh.nova.teachx.ai
  HostName ssh.nova.teachx.ai
  User git
  IdentityFile ~/.ssh/id_gitlab
  IdentitiesOnly yes

Host ttl-monorepo
  HostName ttl-monorepo
  User rarora
  IdentityFile ~/.ssh/id_ttl_monorepo
  IdentitiesOnly yes
  ProxyCommand gcloud compute start-iap-tunnel %h %p --listen-on-stdin --project=teachx-data-platform --zone=us-central1-a --verbosity=warning
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  ServerAliveInterval 60
  ServerAliveCountMax 5
